        <mxCell id="edgeTicketDb" value="Dự kiến" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=both;endFill=1;dashed=1;strokeColor=#9673A6;fontSize=11;" edge="1" parent="1" source="futureTicket" target="database">
